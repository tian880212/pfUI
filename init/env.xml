<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <!-- Only the locales that are actually shipped are listed here. The other
       language packs (koKR/frFR/deDE/esES/ruRU) still exist in env\unused\ but
       are no longer parsed at load time: together they were ~24k lines of pure
       data tables that every client paid for, no matter which language the
       player used. To bring one back, move the file into env\ and add its
       Include line here again. -->
  <Include file="..\env\locales_enUS.lua"/>
  <Include file="..\env\locales_zhCN.lua"/>

  <Include file="..\env\tables.lua"/>
  <Include file="..\env\profiles.lua"/>

  <!-- translations_enUS.lua must stay: pfUI.lua falls back to it whenever the
       configured language has no translation table. -->
  <Include file="..\env\translations_enUS.lua"/>
  <Include file="..\env\translations_zhCN.lua"/>
</Ui>
